# mock = MSW 가 네트워크를 가로챈다 · real = 진짜 백엔드 (api.md §7.2)
#
# ⚠️ Expo 는 EXPO_PUBLIC_ 접두만 클라이언트 번들에 주입한다.
#    VITE_ 를 쓰면 undefined 로 들어와 조용히 real 로 떨어진다.
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# MSW 시나리오 — 예외 화면을 백엔드보다 먼저 만든다 (api.md §7.2)
# happy · seat-conflict · seat-lock-timeout · hold-expired · payment-pending
# payment-declined · login-throttled · not-owned · not-found · server-error
EXPO_PUBLIC_MOCK_SCENARIO=happy
